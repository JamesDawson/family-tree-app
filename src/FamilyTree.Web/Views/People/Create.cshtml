@using FamilyTree.Data.Models
@model PersonFormModel
@{
    var related = ViewData["RelatedPerson"] as Person;
    var heading = related is null ? "Add person" : $"Add {Model.Relation} of {related.Name.DisplayName}";
    ViewData["Title"] = heading;
}

<h1>@heading</h1>

<form asp-route="PeopleCreate" method="post" hx-disabled-elt="find button[type=submit]">
    <partial name="_PersonForm" />
</form>
