@using FamilyTree.Data.Images
@model PersonWithRelationships
@{
    var person = Model.Person;
    ViewData["Title"] = person.Name.DisplayName;
}

<h1>@person.Name.DisplayName</h1>

@if (TempData["DeleteError"] is string deleteError)
{
    <p class="error">@deleteError</p>
}

<p class="actions">
    <a class="button" asp-action="Edit" asp-route-id="@person.Id">Edit</a>
    <a class="button" asp-action="Graph" asp-route-id="@person.Id">Family Tree</a>
    <a class="button" asp-action="Tree" asp-route-id="@person.Id">Ancestor tree</a>
    <a class="button" asp-action="History" asp-route-id="@person.Id">History</a>
    <button type="button" class="button danger"
            hx-post="@Url.Action("Delete", new { id = person.Id })"
            hx-confirm="Delete @person.Name.DisplayName? Their file will be removed, but every prior version stays in git history and can be restored.">
        Delete
    </button>
</p>

<dl class="facts">
    <dt>Sex</dt>
    <dd>@person.Sex</dd>
    <dt>Born</dt>
    <dd>@person.BornOn?.ToDisplayString() @(string.IsNullOrWhiteSpace(person.BornPlace) ? "" : $"in {person.BornPlace}")</dd>
    <dt>Died</dt>
    <dd>@(person.DiedOn is null ? "—" : $"{person.DiedOn.ToDisplayString()} {(string.IsNullOrWhiteSpace(person.DiedPlace) ? "" : $"in {person.DiedPlace}")}")</dd>
</dl>

<section>
    <h2>Notes</h2>
    <partial name="_Notes" model="@person.Notes" />
</section>

<section>
    <h2>Photos</h2>
    <partial name="_Images" model="@((person.Id, (IReadOnlyList<PersonImage>)(ViewData["Images"] as IReadOnlyList<PersonImage> ?? [])))" />
</section>

<section>
    @* Collapsed by default; the buttons and any results live inside it. *@
    <details class="external-search">
        <summary><h2>Search external sources</h2></summary>
        @* Fetches only the list of applicable sources, the first time the section is opened; nothing is sent to a third party until a source is chosen. *@
        @* hx-target must be explicit: <body> sets hx-target="#main-content", which children inherit, so without it the list would replace the whole page. *@
        <div hx-get="@Url.Action("Sources", "ExternalSearch", new { id = person.Id })"
             hx-trigger="toggle once from:closest details"
             hx-target="this"
             hx-swap="innerHTML">
            <p class="muted">Loading…</p>
        </div>
    </details>
</section>

<section>
    <h2>Parents</h2>
    @if (Model.Parents.Count == 0)
    {
        <p class="muted">None recorded.</p>
    }
    else
    {
        <ul>
            @foreach (var parent in Model.Parents)
            {
                <li>
                    <a asp-action="Details" asp-route-id="@parent.Id">@parent.Name.DisplayName</a>
                    <button type="button" class="link-button"
                            hx-post="@Url.Action("RemoveParent", new { id = person.Id, parentId = parent.Id })"
                            hx-confirm="Remove @parent.Name.DisplayName as a parent of @person.Name.DisplayName?">
                        Remove
                    </button>
                </li>
            }
        </ul>
    }

    <div class="add-relationship">
        <input type="search" placeholder="Add a parent…" name="q"
               hx-get="@Url.Action("Search")"
               hx-trigger="keyup changed delay:300ms"
               hx-target="#parent-search-results"
               hx-vals='{"personId":"@person.Id","relationshipKind":"parent"}' />
        <div id="parent-search-results"></div>
    </div>
</section>

<section>
    <h2>Children</h2>
    @if (Model.Children.Count == 0)
    {
        <p class="muted">None recorded.</p>
    }
    else
    {
        <ul>
            @foreach (var child in Model.Children)
            {
                <li>
                    <a asp-action="Details" asp-route-id="@child.Id">@child.Name.DisplayName</a>
                    <button type="button" class="link-button"
                            hx-post="@Url.Action("RemoveChild", new { id = person.Id, childId = child.Id })"
                            hx-confirm="Remove @child.Name.DisplayName as a child of @person.Name.DisplayName?">
                        Remove
                    </button>
                </li>
            }
        </ul>
    }

    <div class="add-relationship">
        <input type="search" placeholder="Add an existing child…" name="q"
               hx-get="@Url.Action("Search")"
               hx-trigger="keyup changed delay:300ms"
               hx-target="#child-search-results"
               hx-vals='{"personId":"@person.Id","relationshipKind":"child"}' />
        <div id="child-search-results"></div>
    </div>
</section>

<section>
    <h2>Siblings</h2>
    @if (Model.Siblings.Count == 0)
    {
        <p class="muted">None recorded.</p>
    }
    else
    {
        <ul>
            @foreach (var sibling in Model.Siblings)
            {
                <li>
                    <a asp-action="Details" asp-route-id="@sibling.Person.Id">@sibling.Person.Name.DisplayName</a>
                    @(sibling.Full ? "" : "(half)")
                    <button type="button" class="link-button"
                            hx-post="@Url.Action("RemoveSibling", new { id = person.Id, siblingId = sibling.Person.Id })"
                            hx-confirm="Unlink @sibling.Person.Name.DisplayName as a sibling of @person.Name.DisplayName? They will no longer share parents.">
                        Remove
                    </button>
                </li>
            }
        </ul>
    }

    <div class="add-relationship">
        <input type="search" placeholder="Add an existing sibling…" name="q"
               hx-get="@Url.Action("Search")"
               hx-trigger="keyup changed delay:300ms"
               hx-target="#sibling-search-results"
               hx-vals='{"personId":"@person.Id","relationshipKind":"sibling"}' />
        <div id="sibling-search-results"></div>
    </div>
</section>

<section>
    <h2>Spouses</h2>
    @if (Model.Spouses.Count == 0)
    {
        <p class="muted">None recorded.</p>
    }
    else
    {
        <ul>
            @foreach (var spouse in Model.Spouses)
            {
                <li>
                    <a asp-action="Details" asp-route-id="@spouse.Person.Id">@spouse.Person.Name.DisplayName</a>
                    @(spouse.Relationship.MarriedOn is null ? "" : $"married {spouse.Relationship.MarriedOn.ToDisplayString()}")
                    @(spouse.Relationship.Current ? "" : "(former)")
                    <button type="button" class="link-button"
                            hx-post="@Url.Action("RemoveSpouse", new { id = person.Id, spouseId = spouse.Person.Id })"
                            hx-confirm="Remove the spouse link between @person.Name.DisplayName and @spouse.Person.Name.DisplayName?">
                        Remove
                    </button>
                </li>
            }
        </ul>
    }

    <div class="add-relationship">
        <form id="add-spouse-form" class="inline-fields">
            <partial name="_DateInput" model="@("marriedOn", (string?)null, "Married on (e.g. 02-Jun-1974)", (string?)null)" />
            <partial name="_DateInput" model="@("divorcedOn", (string?)null, "Divorced on (optional)", (string?)null)" />
            <label><input type="checkbox" name="current" value="true" checked /> Current</label>
        </form>
        <input type="search" placeholder="Add a spouse…" name="q"
               hx-get="@Url.Action("Search")"
               hx-trigger="keyup changed delay:300ms"
               hx-target="#spouse-search-results"
               hx-vals='{"personId":"@person.Id","relationshipKind":"spouse"}' />
        <div id="spouse-search-results"></div>
    </div>
</section>
