@using FamilyTree.Data.Models
@model PersonFormModel

@* asp-validation-summary overwrites this element's class itself (validation-summary-valid /
   validation-summary-errors), so no class is set here — see site.css. *@
<div asp-validation-summary="All"></div>

@* Relationship context, present only when adding a relative of an existing person (Create form). *@
@if (!string.IsNullOrEmpty(Model.Relation))
{
    <input type="hidden" asp-for="Relation" />
    <input type="hidden" asp-for="RelatedToId" />

    if (Model.Relation == "child" && ViewData["SpouseChoices"] is List<Person> spouseChoices && spouseChoices.Count > 0)
    {
        <div class="form-field">
            <label asp-for="SecondParentId"></label>
            <select asp-for="SecondParentId">
                <option value="">None / unknown</option>
                @foreach (var s in spouseChoices)
                {
                    <option value="@s.Id" selected="@(s.Id == Model.SecondParentId)">@s.Name.DisplayName</option>
                }
            </select>
        </div>
    }
    else if (Model.Relation == "spouse")
    {
        <div class="form-field">
            <label asp-for="MarriedOn"></label>
            <partial name="_DateInput" model="@(nameof(Model.MarriedOn), Model.MarriedOn, "e.g. 15-Jun-2001, Jan/Mar-2001, 2001", (string?)null)" />
        </div>
        <div class="form-field">
            <label asp-for="DivorcedOn"></label>
            <partial name="_DateInput" model="@(nameof(Model.DivorcedOn), Model.DivorcedOn, "e.g. 02-Nov-2010, Oct/Dec-2010", (string?)null)" />
        </div>
        <div class="form-field">
            <label><input type="checkbox" asp-for="CurrentSpouse" /> Current spouse</label>
        </div>
    }
}

<div class="form-field">
    <label asp-for="FirstName"></label>
    <input asp-for="FirstName" />
</div>
<div class="form-field">
    <label asp-for="MiddleName"></label>
    <input asp-for="MiddleName" />
</div>
<div class="form-field">
    <label asp-for="LastName"></label>
    <input asp-for="LastName" />
</div>
<div class="form-field">
    <label asp-for="MaidenName"></label>
    <input asp-for="MaidenName" />
</div>
<div class="form-field">
    <label asp-for="Sex"></label>
    <select asp-for="Sex">
        <option value="unknown">Unknown</option>
        <option value="female">Female</option>
        <option value="male">Male</option>
    </select>
</div>
<div class="form-field">
    <label asp-for="BornOn"></label>
    <partial name="_DateInput" model="@(nameof(Model.BornOn), Model.BornOn, "e.g. 15-Jun-1976, Jul/Sep-1976, 1976, abt 1976", (string?)null)" />
</div>
<div class="form-field">
    <label asp-for="BornPlace"></label>
    <input asp-for="BornPlace" />
</div>
<div class="form-field">
    <label asp-for="DiedOn"></label>
    <partial name="_DateInput" model="@(nameof(Model.DiedOn), Model.DiedOn, "e.g. 02-Nov-1998, Oct/Dec-1998, bef 2000", (string?)null)" />
</div>
<div class="form-field">
    <label asp-for="DiedPlace"></label>
    <input asp-for="DiedPlace" />
</div>
<div class="form-field">
    <label asp-for="Notes"></label>
    <textarea asp-for="Notes" rows="8" placeholder="Markdown supported"></textarea>
</div>

<button type="submit" class="button">Save</button>
@* Hidden until htmx marks the form as in flight (see site.css); saving includes the git push. *@
<span class="saving-indicator" role="status" aria-live="polite">Saving…</span>
