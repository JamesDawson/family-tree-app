@using System.Reflection
@functions {
    // Informational version may carry "+<commit sha>" build metadata; keep the SHA short.
    private static readonly string AppVersion = GetAppVersion();

    private static string GetAppVersion()
    {
        string? version = typeof(Program).Assembly
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion;
        if (string.IsNullOrEmpty(version))
        {
            return "unknown";
        }

        int plus = version.IndexOf('+');
        return plus >= 0 && version.Length > plus + 8 ? version[..(plus + 8)] : version;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Family Tree</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body hx-boost="true" hx-target="#main-content" hx-swap="innerHTML">
    <header class="site-header">
        <nav class="site-nav">
            <a class="site-brand" asp-controller="Home" asp-action="Index">Family Tree</a>
            <a asp-controller="People" asp-action="Index">People</a>
            <a asp-controller="People" asp-action="Create">Add person</a>
        </nav>
    </header>
    <main id="main-content" class="site-main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        Family Tree v@(AppVersion)
    </footer>
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/graph.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
