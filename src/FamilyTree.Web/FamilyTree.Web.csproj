<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\FamilyTree.Data\FamilyTree.Data.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      The static web assets pipeline's precompressed (.gz) variants are only actually written to disk
      during `dotnet publish`, but the endpoints manifest advertises them unconditionally — so a plain
      `dotnet build` + `dotnet run`/`dotnet FamilyTree.Web.dll` (this app's normal, expected way to run
      locally; it isn't published/deployed) serves an empty body with stale headers to any real browser,
      since every browser sends "Accept-Encoding: gzip". Compression isn't worth anything for a local
      single-user app anyway, so it's simplest to just turn it off. Published builds (including the
      container image) do write the compressed variants, so compression stays on for those.
    -->
    <CompressionEnabled Condition="'$(_IsPublishing)' != 'true'">false</CompressionEnabled>
  </PropertyGroup>

  <!--
    Container image (.NET SDK container support): dotnet publish -t:PublishContainer
    No trimming/AOT: LibGit2Sharp is native and YamlDotNet is reflection-based.
  -->
  <PropertyGroup>
    <ContainerRepository>family-tree-web</ContainerRepository>
    <ContainerFamily>noble-chiseled</ContainerFamily>
    <ContainerRuntimeIdentifier>linux-x64</ContainerRuntimeIdentifier>
    <!-- Publish must target the same RID as the image (a plain build/run stays portable). -->
    <RuntimeIdentifier Condition="'$(_IsPublishing)' == 'true'">$(ContainerRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
    <ContainerEnvironmentVariable Include="FamilyTreeData__RepositoryPath" Value="/data" />
  </ItemGroup>

</Project>
