# Copy to .env and edit. Read automatically by `docker compose`.
COMMIT_AUTHOR_NAME=Your Name
COMMIT_AUTHOR_EMAIL=you@example.com

# Optional: sync the data with a GitHub repo. Use the HTTPS URL (not SSH).
# The PAT should be a fine-grained token limited to that repo with "Contents: Read and write".
# DATA_REPO_URL=https://github.com/<owner>/<repo>.git
# GITHUB_PAT=

# Optional
# FAMILY_TREE_TAG=1.0.0
# FAMILY_TREE_PORT=8080
